آءُ وَيَهْدِى مَن يَشَآءُ ۚ وَمَا يَعْلَمُ جُنُودَ رَبِّكَ إِلَّا هُوَ ۚ وَمَا هِىَ إِلَّا ذِكْرَىٰ لِلْبَشَرِ","urdu":"وَمَا جَعَلۡنَاۤ أَصۡحَـٰبَ ٱلنَّارِ إِلَّا مَلَـٰۤىِٕكَةࣰۖ وَمَا جَعَلۡنَا عِدَّتَهُمۡ إِلَّا فِتۡنَةࣰ لِّلَّذِینَ كَفَرُوا۟ لِیَسۡتَیۡقِنَ ٱلَّذِینَ أُوتُوا۟ ٱلۡكِتَـٰبَ وَیَزۡدَادَ ٱلَّذِینَ ءَامَنُوۤا۟ إِیمَـٰنࣰا وَلَا یَرۡتَابَ ٱلَّذِینَ أُوتُوا۟ ٱلۡكِتَـٰبَ وَٱلۡمُؤۡمِنُونَ وَلِیَقُولَ ٱلَّذِینَ فِی قُلُوبِهِم مَّرَضࣱ وَٱلۡكَـٰفِرُونَ مَاذَاۤ أَرَادَ ٱللَّهُ بِهَـٰذَا مَثَلࣰاۚ كَذَ ٰ⁠لِكَ یُضِلُّ ٱللَّهُ مَن یَشَاۤءُ وَیَهۡدِی مَن یَشَاۤءُۚ وَمَا یَعۡلَمُ جُنُودَ رَبِّكَ إِلَّا هُوَۚ وَمَا هِیَ إِلَّا ذِكۡرَىٰ لِلۡبَشَرِ\n"},{"number":5527,"numberInSurah":32,"arabic":"كَلَّا وَٱلْقَمَرِ","urdu":"كَلَّا وَٱلۡقَمَرِ\n"},{"number":5528,"numberInSurah":33,"arabic":"وَٱلَّيْلِ إِذْ أَدْبَرَ","urdu":"وَٱلَّیۡلِ إِذۡ أَدۡبَرَ\n"},{"number":5529,"numberInSurah":34,"arabic":"وَٱلصُّبْحِ إِذَآ أَسْفَرَ","urdu":"وَٱلصُّبۡحِ إِذَاۤ أَسۡفَرَ\n"},{"number":5530,"numberInSurah":35,"arabic":"إِنَّهَا لَإِحْدَى ٱلْكُبَرِ","urdu":"إِنَّهَا لَإِحۡدَى ٱلۡكُبَرِ\n"},{"number":5531,"numberInSurah":36,"arabic":"نَذِيرًۭا لِّلْبَشَرِ","urdu":"نَذِیرࣰا لِّلۡبَشَرِ\n"},{"number":5532,"numberInSurah":37,"arabic":"لِمَن شَآءَ مِنكُمْ أَن يَتَقَدَّمَ أَوْ يَتَأَخَّرَ","urdu":"لِمَن شَاۤءَ مِنكُمۡ أَن یَتَقَدَّمَ أَوۡ یَتَأَخَّرَ\n"},{"number":5533,"numberInSurah":38,"arabic":"كُلُّ نَفْسٍۭ بِمَا كَسَبَتْ رَهِينَةٌ","urdu":"كُلُّ نَفۡسِۭ بِمَا كَسَبَتۡ رَهِینَةٌ\n"},{"number":5534,"numberInSurah":39,"arabic":"إِلَّآ أَصْحَٰبَ ٱلْيَمِينِ","urdu":"إِلَّاۤ أَصۡحَـٰبَ ٱلۡیَمِینِ\n"},{"number":5535,"numberInSurah":40,"arabic":"فِى جَنَّٰتٍۢ يَتَسَآءَلُونَ","urdu":"فِی جَنَّـٰتࣲ یَتَسَاۤءَلُونَ\n"},{"number":5536,"numberInSurah":41,"arabic":"عَنِ ٱلْمُجْرِمِينَ","urdu":"عَنِ ٱلۡمُجۡرِمِینَ\n"},{"number":5537,"numberInSurah":42,"arabic":"مَا سَلَكَكُمْ فِى سَقَرَ","urdu":"مَا سَلَكَكُمۡ فِی سَقَرَ\n"},{"number":5538,"numberInSurah":43,"arabic":"قَالُوا۟ لَمْ نَكُ مِنَ ٱلْم